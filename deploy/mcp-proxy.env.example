# /etc/mcp-proxy/mcp-proxy.env
#
# Operator configuration for mcp-proxy. Install mode 0640, owned by the
# service user. Every value below is optional — the binary has a safe
# fallback for each, and an unparseable value logs a warning and uses the
# default rather than refusing to boot.
#
#   systemctl restart mcp-proxy   after editing

# ---------------------------------------------------------------- networking
# Bind to loopback when nginx terminates TLS on the same droplet. Use :8080
# only if a cloud firewall restricts who can reach the port.
MCP_LISTEN_ADDR=127.0.0.1:8080

# Required when a reverse proxy on the same host forwards to us: the request
# then arrives from 127.0.0.1 carrying a public Host header, which the SDK's
# DNS-rebinding guard rejects with 403. Only safe because MCP_LISTEN_ADDR
# above is not publicly reachable.
MCP_DISABLE_LOCALHOST_PROTECTION=true

# ------------------------------------------------- serialization (spec §3)
# Tier 1: up to this many rows come back as structured JSON.
MCP_JSON_MAX_ROWS=100
# Tier 2: up to this many rows come back as CSV. Beyond it, tier 3 truncates
# at this ceiling and appends a truncation warning.
MCP_CSV_MAX_ROWS=2000
# Independent byte ceiling. Row counts alone do not bound memory — a few
# hundred rows holding large text or bytea columns can still be gigabytes.
MCP_MAX_RESULT_BYTES=33554432

# ------------------------------------------- defaults for optional headers
# Engine used when a client sends no x-db-type header.
# Accepted: postgres | postgresql | pg | mysql | mariadb
MCP_DEFAULT_DB_TYPE=postgres
MCP_DEFAULT_DATABASE=postgres
# libpq vocabulary for both engines; translated to the MySQL driver's TLS
# setting automatically (require -> skip-verify, verify-* -> full validation).
MCP_DEFAULT_SSLMODE=prefer

# ------------------------------------------------------- per-tenant limits
MCP_QUERY_TIMEOUT_MS=30000
MCP_CONNECT_TIMEOUT_MS=10000
# Concurrent connections allowed per SSE stream, against the tenant's own
# database. Keep this small: it is multiplied by the number of live streams.
MCP_POOL_MAX_CONNS=4
MCP_POOL_MAX_CONN_IDLE_MS=60000
MCP_POOL_MAX_CONN_LIFETIME_MS=1800000

# ------------------------------------------------------------- guardrails
# Keep INSERT, UPDATE, DELETE, REPLACE and MERGE in the permitted command
# set. Set false for a query-only deployment.
#
# This is a convenience toggle, not an enforcement mechanism: the dependable
# way to make access read-only is to grant the role in x-db-username nothing
# but SELECT. Do that as well.
MCP_ALLOW_WRITES=true

# Refuse tenant hosts in loopback and RFC1918 ranges. Link-local (and so the
# 169.254.169.254 metadata endpoint) is always refused regardless of this.
# Turn this ON for a public multi-tenant deployment; leave it OFF only if
# tenants legitimately point at databases inside your own VPC.
MCP_BLOCK_PRIVATE_HOSTS=false

# Extra blocked patterns, comma separated, matched case-insensitively against
# comment- and literal-stripped SQL.
# MCP_EXTRA_BLOCKED_PATTERNS=\bINFORMATION_SCHEMA\b,\bPG_AUTHID\b

# ---------------------------------------------------------------- lifecycle
MCP_SHUTDOWN_GRACE_MS=15000
MCP_IDLE_TIMEOUT_MS=120000
MCP_LOG_LEVEL=info
